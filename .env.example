NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave-publica
# Compatibilidade temporária com projetos antigos; pode ficar vazia quando a publishable key estiver configurada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integração de cobrança no servidor. Deixe vazias enquanto não houver provedor ativo.
HORARIA_BILLING_PROVIDER=
HORARIA_BILLING_WEBHOOK_SECRET=
# Chave privada exclusiva do servidor. Nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# Cloudflare Turnstile. A mesma site key protege cadastro e formulários públicos.
# No Supabase, habilite Auth > Bot and Abuse Protection > CAPTCHA (Turnstile)
# e configure a Secret Key diretamente no painel; nunca coloque a secret no frontend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
